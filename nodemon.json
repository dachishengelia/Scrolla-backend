{
  "watch": [
    "server.js",
    "routes",
    "controllers",
    "models",
    "middlewares",
    "config",
    "db",
    "strategies",
    "utils"
  ],
  "ignore": [
    "node_modules",
    "public",
    "*.test.js",
    "*.spec.js"
  ],
  "ext": "js,json,mjs",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs"
}
